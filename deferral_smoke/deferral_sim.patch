+// ===========================================================================
+// Expert-deferral simulation  (Mericanii experiment 4.1-smoke)
+// ===========================================================================
+//
+// PURPOSE
+//   The planned optimisation is to let the CPU-resident routed experts of the
+//   first k blocks run *concurrently* with GPU work by allowing their output to
+//   join the residual stream d blocks late. That build is expensive; the cheap
+//   killable risk is QUALITY. This code simulates ONLY the numerical effect of
+//   that staleness. There is NO scheduling change whatsoever: the graph is
+//   still built and executed strictly serially, at exactly the same cost.
+//   Only the residual-join point of the routed-expert output moves.
+//
+// CONTROL (env vars, no CLI plumbing)
+//   LLAMA_DEFER_DEPTH  = d   0 = off (default, bit-identical to stock), 1..3
+//   LLAMA_DEFER_LAYERS = k   defer only blocks 0..k-1. Default 16, matching the
+//                            production `--n-cpu-moe 16`. Clamped to n_layer.
+//
+// SEMANTICS
+//   For block i < k:
+//     * the routed-expert output moe_out(i) is computed, as always, from
+//       block i's OWN post-attention-normed hidden state. This is essential for
+//       faithfulness: a real overlapped implementation dispatches the CPU work
+//       the moment block i's normed hidden state exists, so the expert INPUT is
+//       never stale -- only the join of its OUTPUT is late.
+//     * moe_out(i) is NOT added into block i's residual.
+//     * moe_out(i) is instead added into the residual stream at the TOP of
+//       block i+d+1 -- equivalently, at the END of block i+d instead of the end
+//       of block i. So it is ABSENT from the input of blocks i+1 .. i+d, and
+//       PRESENT from block i+d+1 onward. Exactly d blocks run stale, which is
+//       exactly d full blocks of GPU work a real scheduler can overlap the CPU
+//       expert compute with.
+//
+//       THE +1 IS NOT AN OFF-BY-ONE, IT IS THE POINT. Joining at the top of
+//       block i+d (without the +1) would be a no-op at d=1: block i's own
+//       contribution is normally added at the end of block i, and nothing but
+//       the (identity, absent control vectors) build_cvec sits between there and
+//       the top of block i+1. Verified empirically -- that wiring produced
+//       bit-identical logits to stock at d=1. See NOTES.md section 2.
+//     * the gated SHARED expert is unaffected and joins immediately. This is
+//       correct: `--n-cpu-moe N` only overrides tensors matching
+//       "\\.ffn_(up|down|gate|gate_up)_(ch|)exps", which does not match
+//       "ffn_*_shexp" nor "ffn_gate_inp", so the shared expert and the router
+//       both stay GPU-resident in production.
+//
+// CONSERVATION
+//   Every contribution is delivered exactly once. Contributions whose target
+//   index i+d+1 lands on a non-deferring block (i.e. >= k) are still joined at
+//   that block's top. Contributions whose target index runs past the end of the
+//   stack are accumulated in the tail slot and flushed into the stream BEFORE
+//   output_norm, so both the LM head and the MTP/NextN seed (res->t_h_nextn,
+//   consumed by blk.40) observe a fully-flushed residual stream. A debug assert
+//   verifies that no pending contribution is left over.
+// ===========================================================================
+
+// Read the two knobs straight out of the environment, into plain ints, at the point of
+// use. No struct, no function-local static, no lambda.
+//
+// This is deliberately the dumbest possible implementation. An earlier version cached
+// the config in `static const llama_defer_cfg cfg = []{...}();`. That worked under
+// clang/macOS but on the Linux/GCC-13 box build the initialiser provably never ran
+// (instrumented: the calling code executed, the lambda body did not), so the config sat
+// at its defaults and deferral was silently OFF while the harness believed it was ON --
+// four "measurements" that would all have been the d=0 baseline. Never cache the thing
+// whose absence is indistinguishable from a valid result.
+static void llama_defer_read_env(int & depth, int & layers) {
+    const char * s_depth  = getenv("LLAMA_DEFER_DEPTH");
+    const char * s_layers = getenv("LLAMA_DEFER_LAYERS");
+
+    depth  = s_depth  ? atoi(s_depth)  : 0;
+    layers = s_layers ? atoi(s_layers) : 16;
+
+    if (depth  < 0) { depth  = 0; }
+    if (layers < 0) { layers = 0; }
+    if (depth == 0 || layers == 0) { depth = 0; layers = 0; }
+}
